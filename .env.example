# Docker Compose defaults. Development only. Never reuse these values in production.
POSTGRES_DB=agendaspa
POSTGRES_USER=agendaspa
POSTGRES_PASSWORD=agendaspa_dev_password
# Host ports. Change them if local services already use 5432, 6379, 3000 or 8080.
# POSTGRES_PORT=5432
# REDIS_PORT=6379
# BACKEND_PORT=3000
# FRONTEND_PORT=8080
JWT_ACCESS_SECRET=dev-only-access-secret-change-me-please-32
FRONTEND_URL=http://localhost:8080
SPA_TIMEZONE=America/Lima
CURRENCY=PEN
SEED_DEMO=true
SEED_ADMIN_EMAIL=admin@agendaspa.local
SEED_ADMIN_PASSWORD=Admin123!
SEED_STAFF_EMAIL=lucia@agendaspa.local
SEED_STAFF_PASSWORD=Staff123!
SEED_CLIENT_EMAIL=cliente@agendaspa.local
SEED_CLIENT_PASSWORD=Client123!
# Optional rate-limit tuning. Defaults match backend/.env.example.
# RATE_LIMIT_WINDOW_MINUTES=15
# RATE_LIMIT_MAX=300
# AUTH_RATE_LIMIT_MAX=20
# BOOKING_RATE_LIMIT_MAX=30
